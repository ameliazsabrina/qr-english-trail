{
  "name": "@bonjotan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup && mkdir -p dist/migrations && cp src/db/migrations/*.sql dist/migrations/",
    "start": "node dist/server.js",
    "start:container": "node dist/migrate-sqlite.js && node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/scripts/migrate-sqlite.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/scripts/seed-sqlite.ts",
    "db:backup": "node --env-file-if-exists=../../.env --import tsx src/scripts/backup-sqlite.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bonjotan/content": "workspace:*",
    "@bonjotan/shared-types": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.2.1",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
