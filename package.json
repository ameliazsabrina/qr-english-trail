{
  "name": "bonjotan-english-trail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @bonjotan/api --filter @bonjotan/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bonjotan/api db:generate",
    "db:migrate": "pnpm --filter @bonjotan/api db:migrate",
    "db:seed": "pnpm --filter @bonjotan/api db:seed",
    "db:backup": "pnpm --filter @bonjotan/api db:backup",
    "db:studio": "pnpm --filter @bonjotan/api db:studio",
    "validate:content": "pnpm --filter @bonjotan/content validate"
  },
  "engines": {
    "node": ">=24.2.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
